#!/usr/bin/env bash
# Regenerate docs/cli.md from `task --help`. `verify` fails if it is stale.
set -euo pipefail
dir=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
# shellcheck disable=SC2016 # the backticks are Markdown
{
	echo '# `task` command line'
	echo
	echo 'Generated from `task --help` by `docs/generate-cli`. Do not edit by hand.'
	echo
	echo '```text'
	"$dir/task" --help
	echo '```'
} >"$dir/docs/cli.md"
