#!/usr/bin/env bash
# Git credential helper (INV-5): answers "get" from the task's token file, so
# the token never lands in .git/config or a remote URL. "store" and "erase"
# are ignored, so git never persists it either.
set -euo pipefail
[[ ${1:-} == get ]] || exit 0
token_file=/run/secrets/github_token
if [[ ! -s $token_file ]]; then
	echo "git-credential-sandbox: $token_file missing or empty" >&2
	exit 1
fi
printf 'username=x-access-token\npassword=%s\n' "$(<"$token_file")"
